PORT=4000
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=archive

MAX_FILE_MB=100

# used only by `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Optional: contact email sent in the User-Agent to Open Library / OpenAlex (faster, politer API access)
DISCOVER_CONTACT=
